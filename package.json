{
  "name": "eleusinia",
  "productName": "Eleusinia",
  "version": "0.0.2",
  "description": "Peer-to-peer chat and voice calls with no central server",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "electron-vite build && node test/smoke.mjs .",
    "inbox": "electron-vite build && electron . --inbox",
    "installer-art": "electron build/installer-art.cjs",
    "dist": "electron-vite build && electron-builder --win --publish never"
  },
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "blind-relay": "^1.3.0",
    "electron-updater": "^6.8.9",
    "hypercore-crypto": "^3.7.0",
    "hyperdht": "^6.34.1",
    "sodium-universal": "5.0.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "private": true,
  "build": {
    "appId": "app.eleusinia.desktop",
    "productName": "Eleusinia",
    "copyright": "Eleusinia developers",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**",
      "**/node_modules/sodium-native/**",
      "**/node_modules/udx-native/**",
      "**/node_modules/*-native/**",
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Eleusinia-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeader": "build/installer-header.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Eleusinia",
      "uninstallDisplayName": "Eleusinia",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mmhfn1",
        "repo": "Eleusinia",
        "releaseType": "release",
        "publisherName": [
          "Eleusinia"
        ]
      }
    ]
  }
}
